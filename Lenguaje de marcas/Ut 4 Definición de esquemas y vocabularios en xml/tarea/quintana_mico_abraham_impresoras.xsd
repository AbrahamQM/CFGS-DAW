<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="impresoras">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="impresora" minOccurs="1" maxOccurs="unbounded"><!-- defino las especificaciones de cada impresora -->
          <xs:complexType><!-- Es un elemento complejo que contiene los campos enumerado a continuacion-->
            <xs:sequence>
              <xs:element name="marca" type="xs:string"></xs:element>

              <xs:element name="modelo" type="xs:string"></xs:element>

              <xs:element name="peso">
                <xs:simpleType><!-- restricciones-->
                  <xs:restriction base="xs:decimal">
                    <xs:minExclusive value="0" />
                    <xs:fractionDigits value="2" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>

              <xs:element name="tamaño" minOccurs="1" maxOccurs="unbounded" type="xs:string"></xs:element>

              <xs:element name="cartucho">
                <xs:simpleType><!-- restricciones-->
                  <xs:restriction base="xs:string">
                    <xs:pattern value="C-[0-9]{3}[A-Z]{1,2}" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>

              <xs:element name="enred" minOccurs="0"></xs:element>
            </xs:sequence>

            <xs:attribute name="numSerie" type="xs:ID" use="required" />

            <xs:attribute name="tipo" use="required">
              <xs:simpleType><!-- restricciones-->
                <xs:restriction base="xs:string">
                  <xs:enumeration value="láser"></xs:enumeration>
                  <xs:enumeration value="matricial"></xs:enumeration>
                  <xs:enumeration value="tinta"></xs:enumeration>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>

            <xs:attribute name="compra">
              <xs:simpleType><!-- restricciones-->
                <xs:restriction base="xs:integer">
                  <xs:minExclusive value="0" />
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>

          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>