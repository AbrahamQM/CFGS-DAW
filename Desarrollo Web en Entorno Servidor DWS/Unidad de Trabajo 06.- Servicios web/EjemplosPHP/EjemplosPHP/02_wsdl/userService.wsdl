<?xml version="1.0" encoding="UTF-8"?>
<definitions name="UserService"
             targetNamespace="http://localhost/02_wsdl/userservice"
             xmlns:tns="http://localhost/02_wsdl/userservice"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
			 xmlns="http://schemas.xmlsoap.org/wsdl/">

    <types>
        <xsd:schema targetNamespace="http://localhost/02_wsdl/userservice">
            <xsd:complexType name="UserInfo">
                <xsd:sequence>
                    <xsd:element name="name" type="xsd:string"/>
                    <xsd:element name="email" type="xsd:string"/>
                    <xsd:element name="age" type="xsd:int"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:complexType name="getUserInfoRequest">
                <xsd:sequence>
                    <xsd:element name="userId" type="xsd:int"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:complexType name="getUserInfoResponse">
                <xsd:sequence>
                    <xsd:element name="userInfo" type="tns:UserInfo"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:element name="getUserInfoRequest" type="tns:getUserInfoRequest"/>
            <xsd:element name="getUserInfoResponse" type="tns:getUserInfoResponse"/>
        </xsd:schema>
    </types>

    <message name="getUserInfoRequest">
        <part name="parameters" element="tns:getUserInfoRequest"/>
    </message>

    <message name="getUserInfoResponse">
        <part name="parameters" element="tns:getUserInfoResponse"/>
    </message>

    <portType name="UserServicePortType">
        <operation name="getUserInfo">
            <input message="tns:getUserInfoRequest"/>
            <output message="tns:getUserInfoResponse"/>
        </operation>
    </portType>

    <binding name="UserServiceBinding" type="tns:UserServicePortType">
        <soap:binding style="document"
                      transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="getUserInfo">
            <soap:operation soapAction="http://localhost/02_wsdl/userservice#getUserInfo"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
    </binding>

    <service name="UserService">
        <port name="UserServicePort" binding="tns:UserServiceBinding">
            <soap:address location="http://localhost/02_wsdl/server.php"/>
        </port>
    </service>

</definitions>
